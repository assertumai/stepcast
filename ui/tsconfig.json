{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,

    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,

    // Имена таблицы, живущие в репозитории: встроенная половина пишет их так
    // же, как плагин (design.md изменения `shared-module-table`, Решения 5,
    // 6). Те же две записи — в `ui/tsconfig.test.json`, `vite.config.ts` и
    // `scripts/build-ui-tests.mjs`.
    "paths": {
      "@stepcast/slots": ["./src/sharedSlots.ts"],
      "@stepcast/ui": ["./src/ui/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../src/ui/routes.ts",
    "../src/ui/grouping.ts",
    "../src/ui/format.ts",
    "../src/ui/transcript.ts",
    "../src/ui/runsView.ts",
    "../src/ui/filters.ts",
    "../src/ui/backlogView.ts",
    "../src/ui/scrumView.ts",
    "../src/ui/sharedModules.ts",
    "../src/ui/screens/declaration.ts",
    "../src/ui/screens/*/declaration.ts",
    "../src/ui/screens/*/report.ts",
    "../src/core/plugins/fibers.ts",
    "../src/core/plugins/services.ts",
    "../vite.config.ts"
  ]
}
