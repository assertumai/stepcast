{
  "title": "stepcast step manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "step"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "file": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "params": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "output_schema": {
      "type": "string"
    },
    "runner": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "kind",
    "name",
    "description",
    "file"
  ],
  "additionalProperties": false
}
