{
  "title": "stepcast plugins patch",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "plugins-patch"
    },
    "plugins": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "use": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "enabled": {
            "type": "boolean"
          },
          "before": {
            "type": "string",
            "minLength": 1
          },
          "after": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "use"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "kind",
    "plugins"
  ],
  "additionalProperties": false
}
