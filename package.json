{
  "name": "stepcast",
  "version": "0.0.0",
  "description": "Движок пайплайнов для разработки с ИИ-агентами",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "stepcast": "./dist/src/bin.js"
  },
  "exports": {
    ".": "./dist/src/core/index.js",
    "./plugin": "./dist/src/plugin.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build:node": "tsc -p tsconfig.json",
    "build:ui": "vite build",
    "build": "npm run build:node && npm run build:ui",
    "dev:ui": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:ui": "tsc -p ui/tsconfig.json --noEmit",
    "lint": "eslint src test ui",
    "test": "npm run build:node && node --test \"dist/test/**/*.test.js\"",
    "test:only": "node --test \"dist/test/**/*.test.js\"",
    "check": "npm run typecheck && npm run typecheck:ui && npm run lint && npm run build && npm run test:only && npm run status:check",
    "schema": "npm run build:node && node dist/scripts/generate-schema.js",
    "status:build": "node scripts/status.mjs --write",
    "status:check": "node scripts/status.mjs --check"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "execa": "^10.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
