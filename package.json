{
  "name": "stepcast",
  "version": "0.0.0",
  "description": "Движок пайплайнов для разработки с ИИ-агентами",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "stepcast": "./dist/src/bin.js"
  },
  "exports": {
    ".": "./dist/src/parts/pipeline/index.js",
    "./plugin": "./dist/src/plugin/index.js",
    "./pipeline": "./dist/src/parts/pipeline/surface.js",
    "./step": "./dist/src/parts/pipeline/step/index.js",
    "./backends/codex": "./dist/src/parts/backends/codex/index.js"
  },
  "files": [
    "dist",
    "schema",
    "src/builtin"
  ],
  "scripts": {
    "build:node": "tsc -p tsconfig.json",
    "build:ui": "vite build",
    "build": "npm run build:node && npm run build:ui",
    "dev:ui": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:ui": "tsc -p ui/tsconfig.json --noEmit",
    "typecheck:ui-test": "tsc -p ui/tsconfig.test.json --noEmit",
    "typecheck:plugin": "tsc -p examples/plugins/board/tsconfig.json && tsc -p examples/plugins/element/tsconfig.json && tsc -p examples/plugins/typed/tsconfig.json --noEmit && tsc -p examples/plugins/command/tsconfig.json --noEmit",
    "lint": "eslint src test ui examples/plugins",
    "test": "npm run build:node && node --test \"dist/test/**/*.test.js\"",
    "test:only": "node --test \"dist/test/**/*.test.js\"",
    "build:ui-test": "node scripts/build-ui-tests.mjs",
    "test:ui": "node --test \"dist/ui-test/**/*.test.js\"",
    "build:plugin-example": "tsc -p examples/plugins/typed/tsconfig.json",
    "check": "npm run typecheck && npm run typecheck:ui && npm run typecheck:ui-test && npm run lint && npm run build && npm run typecheck:plugin && npm run build:plugin-example && npm run build:ui-test && npm run test:only && npm run test:ui",
    "schema": "npm run build:node && node dist/scripts/generate-schema.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "cordis": "4.0.0-rc.10",
    "esbuild": "^0.28.2",
    "execa": "^10.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.0.0",
    "preact": "^10.29.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
