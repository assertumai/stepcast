{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["tasks"],
  "additionalProperties": false,
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "files", "done_when"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "files": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Затрагиваемые файлы"
          },
          "done_when": {
            "type": "string",
            "description": "Чем считать задачу выполненной"
          }
        }
      }
    }
  }
}
