{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["lanes"],
  "additionalProperties": false,
  "properties": {
    "lanes": {
      "type": "object",
      "comment": "Дорожка b необязательна: заход может раздавать один слот, и тогда pick её не называет вовсе. Условие propose-b сравнивает неопределённое значение с true и даёт false — работа пропускается, а не запускается на пустоте.",
      "required": ["a"],
      "additionalProperties": false,
      "properties": {
        "a": { "$ref": "#/$defs/lane" },
        "b": { "$ref": "#/$defs/lane" }
      }
    }
  },
  "$defs": {
    "lane": {
      "type": "object",
      "required": ["filled", "slug", "title", "group", "item"],
      "additionalProperties": false,
      "properties": {
        "filled": { "type": "boolean" },
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "group": { "type": "string" },
        "item": { "type": ["object", "null"] }
      }
    }
  }
}
