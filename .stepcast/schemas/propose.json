{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["slug", "change_dir", "artifacts", "summary"],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Слаг взятого пункта очереди, он же имя OpenSpec-изменения"
    },
    "change_dir": {
      "type": "string",
      "description": "Путь к каталогу заведённого изменения от корня репозитория"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Созданные артефакты изменения"
    },
    "summary": {
      "type": "string",
      "description": "Одна-две фразы о том, что изменение предлагает сделать"
    }
  }
}
